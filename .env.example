# Your T3 API key = the private key of the ETH wallet you registered at
# https://www.terminal3.io/claim-page  (it never leaves your machine; it signs the login challenge)
T3N_API_KEY=0x...
# testnet (default, free sandbox credits) or production
T3N_ENV=testnet
# Language for CLI output: en | de
SECRETSAFE_LANG=en
